{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",

        /* Incremental migration: allow .js and .jsx alongside .ts/.tsx, don't type-check .js yet. */
        "allowJs": true,
        "checkJs": false,

        /* Vite/Babel does the transpiling; tsc is type-check only. */
        "noEmit": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,

        /* Migrating to full strict in phases. Phase A: noImplicitAny.
           Still off: strictNullChecks, strictFunctionTypes, strictPropertyInitialization,
           strictBindCallApply, useUnknownInCatchVariables. */
        "strict": false,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "alwaysStrict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false
    },
    "include": ["src"]
}
